<?php
// SilphNet async presence - shared DB connection TEMPLATE.
// -----------------------------------------------------------------------
// Copy this file to db.php (same folder) and fill in DB_USER / DB_PASS
// with the cPanel MySQL user you created (e.g. jamshark_silphnet / the
// generated password).
//
// db.php itself is gitignored (see .gitignore: server/web/db.php) - only
// this .example template is tracked in git, so a real password never ends
// up in version control even by accident. Edit the real db.php directly
// on the server (or in your own local copy, which git will ignore) - never
// paste real credentials into this template file.
// -----------------------------------------------------------------------

define('DB_HOST', 'localhost');
define('DB_NAME', 'jamshark_silphnet');
define('DB_USER', 'jamshark_silphnet');   // << EDIT ME if you used a different username
define('DB_PASS', 'CHANGE-ME');           // << EDIT ME - set on the server only, never in git

// -----------------------------------------------------------------------
// Recovery email feature (set_email.php / request_password_reset.php /
// reset_password.php) - optional. Leaving these as CHANGE-ME/blank is
// fine; the feature just fails soft (mailer.php logs and returns false,
// email_crypto.php's silphnet_email_key() errors clearly) rather than
// doing anything unsafe, so you can ignore this whole block until you're
// ready to actually wire up a real mailbox.
// -----------------------------------------------------------------------

// 64 hex characters = 32 raw bytes = a real AES-256 key. Generate a new
// one with: php -r "echo bin2hex(random_bytes(32));"
// This key encrypts every stored email address - losing it means every
// already-stored email becomes permanently unreadable (accounts keep
// working fine, they just silently have no recovery email anymore).
// Changing it does NOT re-encrypt existing rows - do that migration
// yourself if you ever need to rotate this key.
define('EMAIL_ENCRYPTION_KEY', 'CHANGE-ME');   // << EDIT ME - 64 hex chars, keep secret, back it up

// SMTP credentials for a real mailbox (Gmail, your own domain's mail
// hosting via Verpex, or any SMTP provider) - used only to send password
// reset emails. SMTP_SECURE should be PHPMailer::ENCRYPTION_STARTTLS
// (the string 'tls') for port 587, or PHPMailer::ENCRYPTION_SMTPS
// (the string 'ssl') for port 465 - check whichever your provider's own
// setup instructions specify.
//
// Example below is filled in for a Verpex-hosted mailbox on port 465
// (implicit TLS/SMTPS, hence 'ssl' not 'tls') - adjust host/port/secure
// to match whatever your own provider's setup instructions say if
// they differ.
define('SMTP_HOST', 'mail.jamshark.co.uk');
define('SMTP_PORT', 465);
define('SMTP_SECURE', 'ssl');
define('SMTP_USER', 'silphnet@jamshark.co.uk');   // usually the full mailbox address
define('SMTP_PASS', 'CHANGE-ME');                 // << EDIT ME - the mailbox's real password, set on the server only, never in git
define('SMTP_FROM_ADDRESS', 'silphnet@jamshark.co.uk');
define('SMTP_FROM_NAME', 'SilphNet');

// -----------------------------------------------------------------------
// Admin recovery key (admin.php / admin_reset_password.php) - lets YOU
// (the site owner) generate a one-off password reset link for a friend who
// has no recovery email on file and can't use the normal forgot-password
// flow at all. Unlike every other CHANGE-ME above, this one does NOT fail
// soft - admin_reset_password.php refuses to work at all while this is
// still 'CHANGE-ME', rather than quietly accepting a well-known default
// value as a real admin key. Generate a real one the same way as the email
// key: php -r "echo bin2hex(random_bytes(32));" - then keep it exactly as
// secret as your own database password, since anyone who has it can reset
// ANY account's password, no email or other proof needed.
// -----------------------------------------------------------------------
define('ADMIN_KEY', 'CHANGE-ME');   // << EDIT ME - set on the server only, never in git

function silphnet_db() {
    static $pdo = null;
    if ($pdo === null) {
        $dsn = 'mysql:host=' . DB_HOST . ';dbname=' . DB_NAME . ';charset=utf8mb4';
        $pdo = new PDO($dsn, DB_USER, DB_PASS, [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
        ]);
    }
    return $pdo;
}

// Every endpoint returns JSON, plain text errors included - never HTML
// error pages, so the mod's JSON-ish parsing never has to guess.
function silphnet_json($data, $code = 200) {
    http_response_code($code);
    header('Content-Type: application/json');
    echo json_encode($data);
    exit;
}

function silphnet_error($msg, $code = 400) {
    silphnet_json(['ok' => false, 'error' => $msg], $code);
}
