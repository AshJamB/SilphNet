# SilphNet ignores

# Server runtime / test artifacts
server/*.log
*.log

# Server runtime data — NEVER commit (contains password hashes + device tokens)
accounts.json
players_backup.json
*.tmp

# Real DB credentials — NEVER commit. Edit DB_PASS/DB_USER (and, if used,
# EMAIL_ENCRYPTION_KEY/SMTP_*) directly on the server; keep db.php.example
# in git as the placeholder template instead.
server/web/db.php
server/web/api/db.php

# Python
__pycache__/
*.pyc
*.pyo

# OS cruft
.DS_Store
Thumbs.db

# Real save file exports — contain a real player's name, trainer ID, and
# party. research/gen1-save-format-findings.md documents what was learned
# from one without needing the raw file itself.
research/*.sav
research/*.SAV
