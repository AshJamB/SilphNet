[Unit]
Description=SilphNet relay server
After=network.target

[Service]
Type=simple
User=silphnet
Group=silphnet
WorkingDirectory=/opt/silphnet/server
# PORT can also be set here instead of on the command line:
# Environment=PORT=7788
ExecStart=/usr/bin/python3 /opt/silphnet/server/silphnet_server.py --port 7788
Restart=on-failure
RestartSec=3

# --- basic hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
