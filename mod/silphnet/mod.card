return {
  summary = "Log in, get a Trainer ID, add friends in-game, and see their last-known positions - async, plain-HTTP presence, no server process required (Android-friendly).",
  author = "Ash",
  tags = { "multiplayer", "online", "overworld", "presence" },
  differences = {
    added = {
      "Trainer ID: a unique 5-digit id (00000-65535, same range as the mainline games) assigned once at registration and shown on the status screen - the key used to add friends in-game.",
      "In-game Add Friend screen: a D-pad digit spinner (UP/DOWN changes a digit, LEFT/RIGHT moves the cursor, A sends the request) - no typing, no web page, just enter a friend's Trainer ID.",
      "Incoming friend requests: polled on the same ~30s cycle as presence, shown as a REQUESTS count on the status screen, paged through and accepted on their own screen (LEFT from the status screen).",
      "GitHub auto-update: manifest.json now sets \"github\" so the launcher's Update / Other Versions can pull new releases directly - see .github/workflows/release-silphnet.yml (packages only mod/silphnet/, never the server source or docs, as a GitHub Release .zip on every push to main that touches the mod).",
      "Friend markers show their name: press A on a friend's map marker to see who it is, in a small text box that closes on A or B - a live lookup done at the moment you press A, not baked in when the marker appeared.",
      "Friends list now shows each friend's Trainer ID, and a LEFT/RIGHT:PAGE hint when you have more than one friend.",
    },
    changed = {
      "Nothing else changed from v1.0.0's async presence model - see that version's notes for the account/presence/marker system.",
    },
    known = {
      "Marker sprite is fixed to SPRITE_RED for now",
      "Multiple game-version tracking (Red/Blue/Yellow as separate characters under one account) is designed into the schema (presence keyed on account_id + game_version) but gameVersion in main.lua isn't wired up to the real ROM yet - defaults to UNKNOWN",
      "No battles, trades or chat - presence and friends only",
      "GitHub auto-update requires the repo to be reachable by the launcher (e.g. public, or however Gen1Recomp's manager handles private-repo auth) - not verified on-device yet",
      "Only 8 friend markers can be identified (pressed on for their name) at once on the same map - plenty for normal use, but raise MARKER_SLOTS in main.lua if ever needed",
    },
  },
  credits = {
    { who = "Ash Brittain (AshJam)", for_ = "SilphNet - concept, code, and server (ash.jamtv.co.uk)" },
    { who = "bryanthaboi", for_ = "Gen1Recomp engine and its mod platform" },
    { who = "Gamecorner33 & alamops", for_ = "Gen1Online / RBY MMO - prior art for the concept" },
  },
  compat = { modApi = 2 },
}
